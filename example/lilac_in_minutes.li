-- This is a comment

let greeting = "Hello".
let character = $C.
let pi = 3.14.

let array = #[1,2,3].
let tuple = #(1,2,3).

-- Classes
class Dice conforms Object {
  sides: Int
  number: Int

  def makeDice withSides: Int -> Dice = 
    Dice { sides: withSides, number: 0 }.

  override describe self:Dice -> String = [sides toString], "sided die".
}

let sixSidedDie    = makeDice withSides: 6 in
let twelveSidedDie = makeDice withSides: 12 in
let result         = [sixSidedDie describe], " and ", [twelveSidedDie describe] in
result.