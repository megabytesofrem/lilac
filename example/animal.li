protocol Dog
  message bark (self) : String
end

protocol Cow
  message moo (self) : String
end

class Clarus
end

implement (Dog, Cow) on Clarus
  message bark (self) = "woof"
  message moo (self) = "moo"
end

implement Clarus
  def getAnimal (self) : String = "dogcow"
  def moof (self) : String = self moo appended: [self bark atIndex: 3]
end

-- Use like
[Clarus alloc] getAnimal
[Clarus alloc] moof