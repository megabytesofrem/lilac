protocol Dog {
  message bark (self) : String
}

protocol Cow {
  message moo (self) : String
}

class Clarus conforms (Dog, Cow) {
  override bark self: Clarus -> String = "woof".
  override moo self: Clarus -> String = "moo".

  def getAnimal self: Clarus -> String = "dogcow".
  def moof self: Clarus -> String = self moo appended: [self bark atIndex: 3].
}

-- Use like
[Clarus alloc] getAnimal
[Clarus alloc] moof